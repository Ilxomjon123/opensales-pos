{
  "name": "opensales-kassa-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vue-tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply pos-registry --local",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.158.0"
  }
}
